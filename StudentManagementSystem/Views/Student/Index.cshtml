@model List<StudentManagementSystem.Models.Student>
<h2>Student List</h2>
<a href="/Student/Create" class="btn btn-primary">Add Student</a>
<table class="table table-bordered table-striped">
	<thead>

		<tr>
			<th>Id </th>
			<th>FullName </th>
			<th>Email </th>
			<th>DateOfBirth </th>
			<th>ClassName </th>
			<th>Section </th>
			<th>Action</th>
			
			
		</tr>
	</thead>
	<tbody>
		@foreach (var student in Model)
		{
			<tr>
				<td>@student.Id</td>
				<td>@student.FullName</td>
				<td>@student.Email</td>
				<td>@student.DateOfBirth.ToString("dd-MM-yyyy")</td>
				<td>@student.ClassName</td>
				<td>@student.Section</td>
				<td>
					<a href="/Student/Edit/@student.Id">Edit</a>
					<a href="/Student/Delete/@student.Id">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>